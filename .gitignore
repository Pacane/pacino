# scratch build output of ./build.sh (regenerate any time); the published sets live in variants/
out/
*.csg
variants_build.log
variants/_m.svg

# KiCad per-user project state and auto-backups (the board itself is generated by tools/pcb_gen.py)
*.kicad_prl
*-backups/

__pycache__/
*.pyc

# graft's local graph cache — regenerable, not committed (run `graft build`).
/graft/
