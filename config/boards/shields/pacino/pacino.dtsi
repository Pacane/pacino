/*
 * Pacino -- hand-wired 5-column + 2-extra + 3-thumb split (the default case variant).
 *
 * Electrical matrix per half: 5 columns x 5 rows.
 *   rows 0-2 = top/home/bottom key rows
 *   row 3    = the two extra keys (columns 1 and 2: under X/C left, ,/. right)
 *   row 4    = thumbs (columns 2,3,4 left; 5,6,7 right -- i.e. the three inner columns)
 * This matches docs/wiring_guide.png: column wires chain each column top-to-bottom including its
 * extra key; the thumb row is its own chain hung on the three inner columns.
 *
 * Pins avoid pro_micro 1/14/15/16 so the nice!view (SPI + CS) can be added without rewiring.
 * Amoeba-King boards put the diode between the switch and the ROW pad: diode-direction col2row.
 */

#include <dt-bindings/zmk/matrix_transform.h>

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,matrix-transform = &default_transform;
    };

    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <10>;
        rows = <5>;
        map = <
RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4)      RC(0,5) RC(0,6) RC(0,7) RC(0,8) RC(0,9)
RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4)      RC(1,5) RC(1,6) RC(1,7) RC(1,8) RC(1,9)
RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4)      RC(2,5) RC(2,6) RC(2,7) RC(2,8) RC(2,9)
        RC(3,1) RC(3,2)                              RC(3,7) RC(3,8)
                RC(4,2) RC(4,3) RC(4,4)      RC(4,5) RC(4,6) RC(4,7)
        >;
    };

    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        diode-direction = "col2row";
        wakeup-source;

        row-gpios
            = <&pro_micro 21 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   /* row 0: top      */
            , <&pro_micro 20 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   /* row 1: home     */
            , <&pro_micro 19 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   /* row 2: bottom   */
            , <&pro_micro 18 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   /* row 3: extras   */
            , <&pro_micro 10 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   /* row 4: thumbs   */
            ;
    };
};
