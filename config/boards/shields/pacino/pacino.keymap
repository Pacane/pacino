/*
 * Default Pacino keymap -- a plain starting point, replace with your own in config/pacino.keymap.
 * 40 keys: 3x5 per half + 2 extras (under X/C and ,/.) + 3 thumbs per half.
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        base_layer {
            display-name = "Base";
            bindings = <
&kp Q      &kp W      &kp E      &kp R      &kp T          &kp Y      &kp U      &kp I      &kp O      &kp P
&kp A      &kp S      &kp D      &kp F      &kp G          &kp H      &kp J      &kp K      &kp L      &kp SEMI
&kp Z      &kp X      &kp C      &kp V      &kp B          &kp N      &kp M      &kp COMMA  &kp DOT    &kp FSLH
           &kp LGUI   &kp LALT                                        &kp MINUS  &kp SQT
                      &kp TAB    &mo 1      &kp SPACE      &kp RET    &mo 2      &kp BSPC
            >;
        };

        lower_layer {
            display-name = "Num";
            bindings = <
&kp N1     &kp N2     &kp N3     &kp N4     &kp N5         &kp N6     &kp N7     &kp N8     &kp N9     &kp N0
&kp F1     &kp F2     &kp F3     &kp F4     &kp F5         &kp LEFT   &kp DOWN   &kp UP     &kp RIGHT  &kp ESC
&kp F6     &kp F7     &kp F8     &kp F9     &kp F10        &kp HOME   &kp PG_DN  &kp PG_UP  &kp END    &kp DEL
           &kp F11    &kp F12                                         &kp LBKT   &kp RBKT
                      &trans     &trans     &trans         &trans     &mo 3      &trans
            >;
        };

        raise_layer {
            display-name = "Sym";
            bindings = <
&kp EXCL   &kp AT     &kp HASH   &kp DLLR   &kp PRCNT      &kp CARET  &kp AMPS   &kp STAR   &kp LPAR   &kp RPAR
&kp GRAVE  &kp TILDE  &kp UNDER  &kp EQUAL  &kp PLUS       &kp LBRC   &kp RBRC   &kp LBKT   &kp RBKT   &kp COLON
&kp LSHFT  &kp PIPE   &kp BSLH   &kp LT     &kp GT         &kp DQT    &kp SQT    &kp SEMI   &kp QMARK  &kp RSHFT
           &trans     &trans                                          &trans     &trans
                      &trans     &mo 3      &trans         &trans     &trans     &trans
            >;
        };

        adjust_layer {
            display-name = "Adj";
            bindings = <
&bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4    &none  &none  &none  &none  &bt BT_CLR
&none        &none        &none        &none        &none           &none  &none  &none  &none  &none
&bootloader  &none        &none        &none        &none           &none  &none  &none  &none  &bootloader
             &none        &none                                            &none  &none
                          &none        &trans       &none           &none  &trans &none
            >;
        };
    };
};
